{
	"schemaVersion": 1,
	"id": "origins-math",
	"version": "${version}",
	"name": "Origins: Math",
	"description": "Adds the capability for you to use math for your Origin powers, as well as enhancing the current capabilities of Resource powers.",
	"authors": [
		"_xRickAstley"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/origins-math",
		"sources": "https://github.com/xrickastley/origins-math",
		"issues": "https://github.com/xrickastley/origins-math/issues"
	},
	"license": "MIT",
	"icon": "assets/origins-math/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.xrickastley.originsmath.OriginsMath"
		],
		"client": [
			"io.github.xrickastley.originsmath.OriginsMathClient"
		],
		"server": [
			"io.github.xrickastley.originsmath.OriginsMathServer"
		],
		"modmenu": [
			"io.github.xrickastley.originsmath.config.OriginsMathModMenu"
		]
	},
	"mixins": [
		"origins-math.mixins.json"
	],
	"accessWidener": "origins-math.accesswidener",
	"depends": {
		"fabricloader": ">=0.15.3",
		"minecraft": "~1.20.2",
		"java": ">=17",
		"fabric-api": "*",
		"origins": "~1.11"
	},
	"custom": {
		"loom:injected_interfaces": {
			"io/github/apace100/apoli/power/ValueModifyingPower": [
				"io/github/xrickastley/originsmath/powers/interfaces/ModifyingPower"
			]
		}
	}
}
